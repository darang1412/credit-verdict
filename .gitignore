# Secrets
.env
kaggle.json

# Data (Home Credit CSVs are large and shouldn't live in git)
data/raw/
data/interim/
data/processed/
data/external/
!data/**/.gitkeep
*.csv
*.csv.zip

# Python
__pycache__/
*.pyc
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Models / artifacts
*.pkl
*.joblib
models/*
!models/.gitkeep

# MLflow local tracking store (logged models/metrics - regenerable by re-running training)
mlruns/
mlflow.db
mlartifacts/

# Power BI: commit the text-based PBIP project in business/powerbi/. Never commit
# the binary .pbix - in Import mode it embeds the data (raw Home Credit rows +
# scored applicants). The PBIP's own cache/settings are ignored by
# business/powerbi/.gitignore.
*.pbix

# OS
.DS_Store
Thumbs.db
