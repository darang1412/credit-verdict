# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Postgres (read by docker-compose.yml and ml/modeling/score_and_write.py) ---
POSTGRES_USER=credit_risk
POSTGRES_PASSWORD=changeme
POSTGRES_DB=credit_risk
# Host port that maps to the container's 5432 (see docker-compose.yml)
POSTGRES_HOST_PORT=5433
