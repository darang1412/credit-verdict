# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Postgres ---
POSTGRES_USER=credit_risk
POSTGRES_PASSWORD=changeme
POSTGRES_DB=credit_risk
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
DATABASE_URL=postgresql://credit_risk:changeme@postgres:5432/credit_risk

# --- Kaggle API (used by ml/pipeline/ to download Home Credit Default Risk data) ---
# Get these from https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- RAG / LLM (adverse action notice generator, later phase) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
