table 'public scored_applications'
	lineageTag: 9512dbfb-c737-4b8b-a103-e17c91e5884b

	measure 'Expected Loss' =
			
			VAR c = [Cutoff Value]
			RETURN
			    SUMX (
			        FILTER (
			            'public scored_applications',
			            'public scored_applications'[calibrated_pd] < c
			        ),
			        'public scored_applications'[calibrated_pd]
			            * 'public scored_applications'[amt_credit]
			    )
		lineageTag: 384eeddc-04c7-4613-8479-d2d409a57458

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Approval Rate at Cutoff' =
			
			VAR c = [Cutoff Value]
			RETURN
			    DIVIDE (
			        CALCULATE (
			            COUNTROWS ( 'public scored_applications' ),
			            'public scored_applications'[calibrated_pd] < c
			        ),
			        COUNTROWS ( 'public scored_applications' )
			    )
		lineageTag: 3b3443f1-81d0-4bb1-bb10-39be8d1722fc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Calibrated PD by Segment' = AVERAGE('public scored_applications'[calibrated_pd])
		lineageTag: e3bd0466-af5a-45e8-8ef2-d0d3411dd9b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg amt_credit' = average('public scored_applications'[amt_credit])
		lineageTag: 33aa7fe1-596c-448d-b547-b2d11864d8f5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Scored Applicants' = COUNTROWS ( 'public scored_applications')
		formatString: 0
		lineageTag: 057f3e4d-dccd-42c3-aeb5-170cec48bcb6

	measure 'Approved Exposure' = ```
			
			VAR c = [Cutoff Value]
			RETURN
			    CALCULATE (
			        SUM ( 'public scored_applications'[amt_credit] ),
			        'public scored_applications'[calibrated_pd] < c
			    )
			
			```
		lineageTag: bb47aaa3-46c9-40b8-ab82-d6e95f7886ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Expected Loss Rate' = ```
			DIVIDE ( [Expected Loss], [Approved Exposure] )
			
			```
		lineageTag: 219b5335-7fe6-4757-b082-591d479c76c6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Share of Expected Loss' =
			
			DIVIDE (
			    [Expected Loss],
			    CALCULATE ( [Expected Loss], ALL ( 'public scored_applications'[risk_segment] ) )
			)
		lineageTag: 1754adb8-c730-4b18-8544-ca39ce4189a5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

